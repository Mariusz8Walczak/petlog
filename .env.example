# SQLite database file, read by drizzle (via @libsql/client) at runtime and by drizzle-kit for migrations.
# Locally this resolves relative to the project root. In Docker it points at the mounted volume (see docker-compose.yml).
DATABASE_URL=file:./data/petlog.db

# Session cookie signing is not used (we store an opaque random token, hashed in the sessions table),
# but SvelteKit needs a stable secret-ish value for other framework features in some setups — reserved for future use.
# SESSION_COOKIE_NAME=petlog_session

# Used by `pnpm run seed` (scripts/seed-user.ts) to create the one household account.
# No public registration UI exists — this is the only way to create a user.
SEED_EMAIL=owner@example.com
SEED_PASSWORD=change-me-please
